generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role             String           @default("USER")
  serviceRequests  ServiceRequest[] @relation("provider")
  customerRequests ServiceRequest[] @relation("customer")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ServiceRequest {
  id           String        @id @default(uuid())
  customerName String
  email        String
  phone        String
  serviceType  String
  details      String
  status       String @default("PENDING")
  providerId   String?
  provider     User?         @relation("provider", fields: [providerId], references: [id])
  customerId   String?
  customer     User?         @relation("customer", fields: [customerId], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  icon      String?
  services  Service[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Service {
  id          String    @id @default(uuid())
  name        String
  description String?
  price       Float    @default(0)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}
